{
    "name": "ui-awesome/html-contracts",
    "type": "library",
    "description": "Shared interfaces for the UI Awesome HTML ecosystem: rendering, attribute management, element typing, and form controls.",
    "keywords": [
        "ui-awesome",
        "html",
        "html-contracts",
        "interfaces",
        "renderable",
        "attributes",
        "form-control",
        "block-element",
        "inline-element",
        "void-element",
        "php"
    ],
    "license": "BSD-3-Clause",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "maglnet/composer-require-checker": "^4.1",
        "php-forge/baseline": "^0.1",        
        "php-forge/coding-standard": "^0.3",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-strict-rules": "^2.0",
        "yii2-extensions/scaffold": "^0.2"
    },
    "autoload": {
        "psr-4": {
            "UIAwesome\\Html\\Contracts\\": "src"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        },
        "scaffold": {
            "allowed-packages": [
                "php-forge/baseline",
                "php-forge/coding-standard"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "yii2-extensions/scaffold": true
        }
    },
    "scripts": {
        "check-dependencies": "./vendor/bin/composer-require-checker check",
        "ecs": "./vendor/bin/ecs --fix",
        "rector": "./vendor/bin/rector process",
        "static": "./vendor/bin/phpstan --memory-limit=-1",
        "tests": "./vendor/bin/phpunit"
    }
}
